# Optional. Local mode works without credentials. Never commit a filled .env.
OPENAI_API_KEY=
# Set a Responses-compatible model available to your API account.
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# This release intentionally supports fictional demo data only.
CARE_MODE=demo
CARE_TIMEZONE=America/Denver
# CARE_DATA_DIR=/absolute/path/to/a/private/demo-data-directory
GRADIO_ANALYTICS_ENABLED=False
